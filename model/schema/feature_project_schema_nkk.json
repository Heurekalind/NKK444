{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "feature_project_schema_nkk.json",
  "title": "NKK444 GeoJSON Feature",
  "description": "Ein Baumstandort oder eine Teilfläche einer Berichtsphase, in WGS 84 [Längengrad, Breitengrad].",
  "type": "object",
  "required": ["type", "properties", "geometry"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "Feature" },
    "id": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["Point", "Polygon", "MultiPolygon", "LineString", "MultiLineString"] },
        "coordinates": { "type": "array" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "Point" } } }, "then": { "properties": { "coordinates": { "$ref": "#/definitions/position" } } } },
        { "if": { "properties": { "type": { "const": "LineString" } } }, "then": { "properties": { "coordinates": { "$ref": "#/definitions/line" } } } },
        { "if": { "properties": { "type": { "const": "MultiLineString" } } }, "then": { "properties": { "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/line" } } } } },
        { "if": { "properties": { "type": { "const": "Polygon" } } }, "then": { "properties": { "coordinates": { "$ref": "#/definitions/polygon" } } } },
        { "if": { "properties": { "type": { "const": "MultiPolygon" } } }, "then": { "properties": { "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/polygon" } } } } }
      ]
    },
    "properties": { "type": "object" }
  },
  "if": {
    "properties": { "geometry": { "type": "object", "properties": { "type": { "const": "Point" } } } }
  },
  "then": { "properties": { "properties": { "$ref": "project_core_schema_nkk.json#/definitions/point" } } },
  "else": { "properties": { "properties": { "$ref": "project_core_schema_nkk.json#/definitions/area" } } },
  "definitions": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ]
    },
    "line": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/position" } },
    "polygon": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/position" } }
    }
  }
}
