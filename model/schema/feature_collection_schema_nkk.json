{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "feature_collection_schema_nkk.json",
  "title": "NKK444 GeoJSON FeatureCollection",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "feature_project_schema_nkk.json" }
    }
  }
}
